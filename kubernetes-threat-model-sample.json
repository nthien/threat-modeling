        "threats": [
          {
            "id": "threat-001",
            "title": "JWT Token bị lộ hoặc giả mạo",
            "description": "Attacker có thể đánh cắp hoặc giả mạo JWT để truy cập trái phép vào hệ thống.",
            "severity": "High",
            "type": "Spoofing",
            "status": "Open",
            "mitigation": "Sử dụng short-lived JWT + Refresh Token rotation. Bắt buộc mTLS giữa các service. Lưu Refresh Token an toàn (HttpOnly cookie hoặc secure storage).",
            "cellId": "proc-auth"
          },
          {
            "id": "threat-002",
            "title": "Lateral movement giữa các microservice",
            "description": "Pod bị compromise trong namespace-core có thể gọi sang các service khác mà không bị chặn.",
            "severity": "High",
            "type": "Tampering",
            "status": "Open",
            "mitigation": "Triển khai NetworkPolicy chặt chẽ giữa các namespace. Sử dụng Service Mesh (Istio/Linkerd) với mTLS bắt buộc. Áp dụng Principle of Least Privilege.",
            "cellId": "tb-core"
          },
          {
            "id": "threat-003",
            "title": "Database credential bị lộ",
            "description": "Secret kết nối database bị lộ do mount không an toàn hoặc hardcode trong code.",
            "severity": "Critical",
            "type": "Information Disclosure",
            "status": "Open",
            "mitigation": "Sử dụng External Secrets Operator + Kubernetes Secrets encryption at rest. Không mount secret trực tiếp vào pod nếu không cần thiết.",
            "cellId": "store-user-db"
          },
          {
            "id": "threat-004",
            "title": "Không có Network Policy giữa các namespace",
            "description": "Pod trong namespace public có thể giao tiếp tự do với namespace data.",
            "severity": "High",
            "type": "Tampering",
            "status": "Open",
            "mitigation": "Bắt buộc implement NetworkPolicy. Chỉ cho phép traffic từ namespace-core đến namespace-data. Deny all traffic mặc định.",
            "cellId": "tb-data"
          },
          {
            "id": "threat-005",
            "title": "Supply chain attack qua container image",
            "description": "Kéo image độc hại từ public registry (Docker Hub) dẫn đến backdoor trong production.",
            "severity": "High",
            "type": "Tampering",
            "status": "Open",
            "mitigation": "Sử dụng private container registry. Bắt buộc image signing + verification. Dùng Kyverno hoặc OPA để enforce policy.",
            "cellId": "proc-ingress"
          }
        ]
      }
